{
  "name": "dieline-to-3d-box",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Reads a 2D packaging dieline and folds it into a closed 3D box in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "esbuild tools/check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check.mjs --log-level=error && node node_modules/.cache/check.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
